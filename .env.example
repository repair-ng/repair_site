# ---- Core ---------------------------------------------------------------
NODE_ENV=production
# Public URL of the app, https, NO trailing slash. Used for CSRF origin checks and Paystack callbacks.
APP_BASE_URL=https://app.example.com

# ---- PostgreSQL (private Docker network host from Dokploy's "Internal Connection URL") ----
# Runtime connection: use a least-privilege role (see docs/DEPLOYMENT.md step 3).
DATABASE_URL=postgresql://repair_app:CHANGE_ME@repair-postgres:5432/repair
# Used ONLY by `npm run migrate` / container start (owner role that can CREATE TABLE). Optional: falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql://repair_owner:CHANGE_ME@repair-postgres:5432/repair

# ---- MinIO (S3 API over the private Docker network) -------------------------
S3_ENDPOINT=http://repair-minio:9000
S3_REGION=us-east-1
S3_BUCKET=repair-media
S3_ACCESS_KEY=repair-app-key        # a bucket-scoped service account, NOT the MinIO root user
S3_SECRET_KEY=CHANGE_ME

# ---- Paystack ----------------------------------------------------------------
# Leave PAYSTACK_SECRET_KEY empty ONLY in local dev (payments auto-succeed). In production an empty key
# makes payments return 503 and the webhook reject everything.
PAYSTACK_SECRET_KEY=sk_live_xxx
# Optional extra layer: only accept webhooks from Paystack's published IPs.
PAYSTACK_ENFORCE_IPS=true

# ---- Scheduled jobs -----------------------------------------------------------
# >= 24 random characters:  openssl rand -base64 32
CRON_SECRET=
