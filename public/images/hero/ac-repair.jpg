<svg viewBox="0 0 800 450" xmlns="http://www.w3.org/2000/svg">
  <rect width="800" height="450" fill="#0F1B30"/>
  <circle cx="680" cy="130" r="170" fill="#1B2637"/>
  <circle cx="70" cy="330" r="150" fill="#1B2637"/>
  <rect x="0" y="360" width="800" height="90" fill="#0C1220"/>

  <!-- AC unit -->
  <rect x="230" y="130" width="340" height="120" rx="20" fill="#F7F5F0"/>
  <rect x="255" y="160" width="290" height="14" rx="7" fill="#E4DFD4"/>
  <rect x="255" y="184" width="290" height="14" rx="7" fill="#E4DFD4"/>
  <rect x="255" y="208" width="290" height="14" rx="7" fill="#E4DFD4"/>
  <circle cx="520" cy="145" r="6" fill="#0FA3A3"/>

  <!-- cool air lines -->
  <g stroke="#0FA3A3" stroke-width="6" stroke-linecap="round" opacity="0.8">
    <path d="M300 260 q10 30 -10 60" fill="none"/>
    <path d="M360 260 q10 30 -10 60" fill="none"/>
    <path d="M420 260 q10 30 -10 60" fill="none"/>
    <path d="M480 260 q10 30 -10 60" fill="none"/>
  </g>

  <!-- gauge -->
  <g transform="translate(620,280)">
    <circle r="46" fill="#F7F5F0"/>
    <circle r="46" fill="none" stroke="#101826" stroke-width="4"/>
    <line x1="0" y1="0" x2="20" y2="-30" stroke="#F4650B" stroke-width="5" stroke-linecap="round"/>
    <circle r="6" fill="#101826"/>
  </g>

  <!-- wrench -->
  <g transform="rotate(30 400 340)">
    <rect x="380" y="300" width="16" height="120" rx="7" fill="#F4650B"/>
    <circle cx="388" cy="292" r="24" fill="none" stroke="#F4650B" stroke-width="14"/>
  </g>
</svg>
